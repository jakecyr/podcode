# Create an API key in the Runpod console and paste it here. Never commit .env.
RUNPOD_API_KEY=rp_your_key_here

# Optional: used by vLLM inside the Pod to download gated Hugging Face models.
HF_TOKEN=

# Required for safe public access to the vLLM endpoint. Use a long random value.
RUNPOD_VLLM_API_KEY=replace-with-a-long-random-secret

# Optional defaults. Command-line flags always win.
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_VOLUME_GB=60
RUNPOD_CONTAINER_DISK_GB=30
RUNPOD_VOLUME_MOUNT_PATH=/workspace
RUNPOD_MODEL_CACHE=/workspace/huggingface
